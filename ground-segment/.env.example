# Copy to .env and adjust. Used by docker-compose and the Django settings.
POSTGRES_DB=etana
POSTGRES_USER=etana
POSTGRES_PASSWORD=etana
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433

# Local dev only: DEBUG defaults off (production-safe). Opt in here so
# runserver/manage.py keep working locally without setting this per-command.
ETANA_DEBUG=1

# Production only (e.g. Railway): a real secret, and the deployed hostname.
# ETANA_SECRET_KEY=
# ETANA_ALLOWED_HOSTS=your-app.up.railway.app
# ETANA_CORS_ALLOWED_ORIGINS=https://your-dashboard.example.com
